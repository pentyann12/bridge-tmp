        "prettifyLogMessage": false, "enableLogDetails": true, "dedupStrategy": "none", "sortOrder": "Descending"
      }
    },
    {
      "type": "row", "title": "Traces", "id": 60, "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 72 }, "panels": []
    },
    {
      "type": "table", "title": "Recent error traces", "id": 61,
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 73 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [ { "refId": "A", "queryType": "traceql", "tableType": "traces", "limit": 20, "query": "{ resource.service.name =~ \"${service:regex}\" && status = error }" } ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm" }
    },
    {
      "type": "table", "title": "Slow requests (> 1s)", "id": 62,
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 73 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "targets": [ { "refId": "A", "queryType": "traceql", "tableType": "traces", "limit": 20, "query": "{ resource.service.name =~ \"${service:regex}\" && kind = server && duration > 1s && span.url.path !~ \".*/actuator.*\" }" } ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm" }
    }
  ]
