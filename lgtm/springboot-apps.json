      "gridPos": { "h": 10, "w": 16, "x": 8, "y": 62 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [ { "refId": "A", "queryType": "range", "maxLines": 300, "expr": "{service_name=~\"${service:regex}\"} | detected_level=~\"(?i)(warn|warning|error|fatal)\"" } ],
