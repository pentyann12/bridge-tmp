{
  "uid": "lgtm-springboot-apps",
  "title": "Spring Boot Applications",
  "description": "Actuator(Micrometer)のメトリクス、Lokiのログ、Tempoのトレースで複数のSpring Bootアプリを横断して見る",
  "tags": ["lgtm", "springboot"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "15s",
  "schemaVersion": 41,
  "time": { "from": "now-1h", "to": "now" },
  "links": [
    { "title": "Tomcat / JVM", "type": "link", "url": "/d/lgtm-tomcat-jvm", "icon": "dashboard", "keepTime": true },
    { "title": "LGTM", "type": "dashboards", "tags": ["lgtm"], "asDropdown": true, "icon": "external link" }
  ],
  "templating": {
    "list": [
      {
        "name": "application",
        "label": "Application",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "qryType": 1, "query": "label_values(http_server_requests_seconds_count, application)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "definition": "label_values(http_server_requests_seconds_count, application)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": { "text": ["All"], "value": ["$__all"] }
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "qryType": 1, "query": "label_values(http_server_requests_seconds_count{application=~\"${application:regex}\"}, instance)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "definition": "label_values(http_server_requests_seconds_count{application=~\"${application:regex}\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": { "text": ["All"], "value": ["$__all"] }
      }
    ]
  },
  "panels": [
    {
      "type": "row", "title": "Overview", "id": 1, "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": []
    },
    {
      "type": "table", "title": "Applications", "id": 2,
      "description": "直近5分。Actuatorへのリクエストは除外",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "format": "table", "instant": true, "range": false, "expr": "count by (application) (count by (application, instance) (http_server_requests_seconds_count{application=~\"${application:regex}\", instance=~\"${instance:regex}\"}))" },
        { "refId": "B", "format": "table", "instant": true, "range": false, "expr": "sum by (application) (rate(http_server_requests_seconds_count{application=~\"${application:regex}\", instance=~\"${instance:regex}\", uri!~\"/actuator.*\"}[5m]))" },
        { "refId": "C", "format": "table", "instant": true, "range": false, "expr": "100 * (sum by (application) (rate(http_server_requests_seconds_count{application=~\"${application:regex}\", instance=~\"${instance:regex}\", uri!~\"/actuator.*\", status=~\"5..\"}[5m])) or 0 * sum by (application) (rate(http_server_requests_seconds_count{application=~\"${application:regex}\", instance=~\"${instance:regex}\", uri!~\"/actuator.*\"}[5m]))) / sum by (application) (rate(http_server_requests_seconds_count{application=~\"${application:regex}\", instance=~\"${instance:regex}\", uri!~\"/actuator.*\"}[5m]))" },
        { "refId": "D", "format": "table", "instant": true, "range": false, "expr": "histogram_quantile(0.95, sum by (application, le) (rate(http_server_requests_seconds_bucket{application=~\"${application:regex}\", instance=~\"${instance:regex}\", uri!~\"/actuator.*\"}[5m])))" },
        { "refId": "E", "format": "table", "instant": true, "range": false, "expr": "sum by (application) (http_server_requests_active_seconds_active_count{application=~\"${application:regex}\", instance=~\"${instance:regex}\"})" },
        { "refId": "F", "format": "table", "instant": true, "range": false, "expr": "60 * sum by (application) (rate(logback_events_total{application=~\"${application:regex}\", instance=~\"${instance:regex}\", level=\"error\"}[5m]))" }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": {
            "excludeByName": { "Time": true },
            "indexByName": { "application": 0, "Value #A": 1, "Value #B": 2, "Value #C": 3, "Value #D": 4, "Value #E": 5, "Value #F": 6 },
            "renameByName": { "application": "Application", "Value #A": "Instances", "Value #B": "Requests/s", "Value #C": "5xx %", "Value #D": "p95", "Value #E": "In flight", "Value #F": "Error logs/min" }
        } },
        { "id": "sortBy", "options": { "sort": [ { "field": "Requests/s", "desc": true } ] } }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Application" }, "properties": [
            { "id": "links", "value": [ { "title": "このアプリだけ表示", "url": "/d/lgtm-springboot-apps?var-application=${__value.raw}&${__url_time_range}" } ] }
          ] },
          { "matcher": { "id": "byName", "options": "Requests/s" }, "properties": [
            { "id": "unit", "value": "reqps" }, { "id": "decimals", "value": 2 },
            { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "lcd" } },
            { "id": "color", "value": { "mode": "continuous-BlPu" } }
          ] },
          { "matcher": { "id": "byName", "options": "5xx %" }, "properties": [
            { "id": "unit", "value": "percent" }, { "id": "decimals", "value": 1 },
            { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 } ] } }
          ] },
          { "matcher": { "id": "byName", "options": "p95" }, "properties": [
            { "id": "unit", "value": "s" },
            { "id": "custom.cellOptions", "value": { "type": "color-text" } },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.5 }, { "color": "red", "value": 1 } ] } }
          ] },
          { "matcher": { "id": "byName", "options": "Error logs/min" }, "properties": [
            { "id": "decimals", "value": 1 },
            { "id": "custom.cellOptions", "value": { "type": "color-text" } },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.1 } ] } }
          ] }
        ]
      },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } }
    },
    {
      "type": "row", "title": "HTTP server", "id": 10, "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 }, "panels": []
    },
    {
      "type": "timeseries", "title": "Request rate", "id": 11,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "legendFormat": "{{application}}", "expr": "sum by (application) (rate(http_server_requests_seconds_count{application=~\"${application:regex}\", instance=~\"${instance:regex}\", uri!~\"/actuator.*\"}[$__rate_interval]))" } ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries", "title": "5xx rate", "id": 12,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "legendFormat": "{{application}}", "expr": "100 * (sum by (application) (rate(http_server_requests_seconds_count{application=~\"${application:regex}\", instance=~\"${instance:regex}\", uri!~\"/actuator.*\", status=~\"5..\"}[$__rate_interval])) or 0 * sum by (application) (rate(http_server_requests_seconds_count{application=~\"${application:regex}\", instance=~\"${instance:regex}\", uri!~\"/actuator.*\"}[$__rate_interval]))) / sum by (application) (rate(http_server_requests_seconds_count{application=~\"${application:regex}\", instance=~\"${instance:regex}\", uri!~\"/actuator.*\"}[$__rate_interval]))" } ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0,
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never", "thresholdsStyle": { "mode": "dashed+area" } },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "transparent", "value": null }, { "color": "red", "value": 5 } ] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries", "title": "p95 latency (exemplars → trace)", "id": 13,
      "description": "点(exemplar)からそのリクエストのトレースへ移動できる。percentiles-histogramの有効化が必要",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "legendFormat": "{{application}}", "exemplar": true, "expr": "histogram_quantile(0.95, sum by (application, le) (rate(http_server_requests_seconds_bucket{application=~\"${application:regex}\", instance=~\"${instance:regex}\", uri!~\"/actuator.*\"}[$__rate_interval])))" } ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "table", "title": "Endpoints", "id": 14,
      "description": "直近5分。maxはMicrometerが保持する直近の最大値",
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "format": "table", "instant": true, "range": false, "expr": "sum by (application, method, uri) (rate(http_server_requests_seconds_count{application=~\"${application:regex}\", instance=~\"${instance:regex}\", uri!~\"/actuator.*\"}[5m]))" },
        { "refId": "B", "format": "table", "instant": true, "range": false, "expr": "100 * (sum by (application, method, uri) (rate(http_server_requests_seconds_count{application=~\"${application:regex}\", instance=~\"${instance:regex}\", uri!~\"/actuator.*\", status=~\"5..\"}[5m])) or 0 * sum by (application, method, uri) (rate(http_server_requests_seconds_count{application=~\"${application:regex}\", instance=~\"${instance:regex}\", uri!~\"/actuator.*\"}[5m]))) / sum by (application, method, uri) (rate(http_server_requests_seconds_count{application=~\"${application:regex}\", instance=~\"${instance:regex}\", uri!~\"/actuator.*\"}[5m]))" },
        { "refId": "C", "format": "table", "instant": true, "range": false, "expr": "histogram_quantile(0.95, sum by (application, method, uri, le) (rate(http_server_requests_seconds_bucket{application=~\"${application:regex}\", instance=~\"${instance:regex}\", uri!~\"/actuator.*\"}[5m])))" },
        { "refId": "D", "format": "table", "instant": true, "range": false, "expr": "max by (application, method, uri) (http_server_requests_seconds_max{application=~\"${application:regex}\", instance=~\"${instance:regex}\", uri!~\"/actuator.*\"})" }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": {
            "excludeByName": { "Time": true },
            "indexByName": { "application": 0, "method": 1, "uri": 2, "Value #A": 3, "Value #B": 4, "Value #C": 5, "Value #D": 6 },
            "renameByName": { "application": "Application", "method": "Method", "uri": "URI", "Value #A": "Requests/s", "Value #B": "5xx %", "Value #C": "p95", "Value #D": "Max" }
        } },
        { "id": "sortBy", "options": { "sort": [ { "field": "Requests/s", "desc": true } ] } }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Requests/s" }, "properties": [
            { "id": "unit", "value": "reqps" }, { "id": "decimals", "value": 2 },
            { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "lcd" } },
            { "id": "color", "value": { "mode": "continuous-BlPu" } }
          ] },
          { "matcher": { "id": "byName", "options": "5xx %" }, "properties": [
            { "id": "unit", "value": "percent" }, { "id": "decimals", "value": 1 },
            { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 } ] } }
          ] },
          { "matcher": { "id": "byRegexp", "options": "^(p95|Max)$" }, "properties": [
            { "id": "unit", "value": "s" },
            { "id": "custom.cellOptions", "value": { "type": "color-text" } },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.5 }, { "color": "red", "value": 1 } ] } }
          ] }
        ]
      },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } }
    },
    {
      "type": "timeseries", "title": "Responses by status", "id": 15,
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "{{status}}", "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=~\"${application:regex}\", instance=~\"${instance:regex}\", uri!~\"/actuator.*\"}[$__rate_interval]))" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "custom": { "drawStyle": "bars", "fillOpacity": 70, "lineWidth": 1, "stacking": { "mode": "normal" }, "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "^2.." }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } } ] },
          { "matcher": { "id": "byRegexp", "options": "^3.." }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } } ] },
          { "matcher": { "id": "byRegexp", "options": "^4.." }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byRegexp", "options": "^5.." }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries", "title": "Exceptions", "id": 16,
      "description": "コントローラーから送出された例外の種類別",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "legendFormat": "{{application}} {{exception}}", "expr": "sum by (application, exception) (rate(http_server_requests_seconds_count{application=~\"${application:regex}\", instance=~\"${instance:regex}\", exception!=\"none\", exception!=\"\"}[$__rate_interval]))" } ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0, "custom": { "drawStyle": "bars", "fillOpacity": 70, "lineWidth": 1, "stacking": { "mode": "normal" }, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries", "title": "In-flight requests", "id": 17,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "legendFormat": "{{application}}", "expr": "sum by (application) (http_server_requests_active_seconds_active_count{application=~\"${application:regex}\", instance=~\"${instance:regex}\"})" } ],
      "fieldConfig": { "defaults": { "unit": "none", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "row", "title": "Dependencies (HTTP client / DB)", "id": 20, "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 35 }, "panels": []
    },
    {
      "type": "timeseries", "title": "Outbound HTTP avg latency", "id": 21,
      "description": "RestClient / RestTemplate / WebClientからの呼び出し先ごと",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "legendFormat": "{{application}} → {{client_name}}", "expr": "sum by (application, client_name) (rate(http_client_requests_seconds_sum{application=~\"${application:regex}\", instance=~\"${instance:regex}\"}[$__rate_interval])) / sum by (application, client_name) (rate(http_client_requests_seconds_count{application=~\"${application:regex}\", instance=~\"${instance:regex}\"}[$__rate_interval]))" } ],
      "fieldConfig": { "defaults": { "unit": "s", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries", "title": "DB connection pool (HikariCP)", "id": 22,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "{{application}} {{pool}} active", "expr": "sum by (application, pool) (hikaricp_connections_active{application=~\"${application:regex}\", instance=~\"${instance:regex}\"})" },
        { "refId": "B", "legendFormat": "{{application}} {{pool}} pending", "expr": "sum by (application, pool) (hikaricp_connections_pending{application=~\"${application:regex}\", instance=~\"${instance:regex}\"})" },
        { "refId": "C", "legendFormat": "{{application}} {{pool}} max", "expr": "max by (application, pool) (hikaricp_connections_max{application=~\"${application:regex}\", instance=~\"${instance:regex}\"})" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".* max$" }, "properties": [
            { "id": "custom.fillOpacity", "value": 0 },
            { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [6, 4] } }
          ] },
          { "matcher": { "id": "byRegexp", "options": ".* pending$" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries", "title": "DB connection acquire time", "id": 23,
      "description": "プールからコネクションを取得するまでの平均待ち時間。増えていればプール枯渇の兆候",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "{{application}} {{pool}}", "expr": "sum by (application, pool) (rate(hikaricp_connections_acquire_seconds_sum{application=~\"${application:regex}\", instance=~\"${instance:regex}\"}[$__rate_interval])) / sum by (application, pool) (rate(hikaricp_connections_acquire_seconds_count{application=~\"${application:regex}\", instance=~\"${instance:regex}\"}[$__rate_interval]))" },
        { "refId": "B", "legendFormat": "{{application}} {{pool}} timeouts/s", "expr": "sum by (application, pool) (rate(hikaricp_connections_timeout_total{application=~\"${application:regex}\", instance=~\"${instance:regex}\"}[$__rate_interval])) > 0" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*timeouts/s$" }, "properties": [
            { "id": "unit", "value": "short" },
            { "id": "custom.axisPlacement", "value": "right" },
            { "id": "custom.drawStyle", "value": "bars" },
            { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }
          ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "row", "title": "Logs", "id": 30, "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 44 }, "panels": []
    },
    {
      "type": "timeseries", "title": "Log events by level", "id": 31,
      "description": "Logbackが出力したログの件数 (Actuatorのメトリクス)",
      "gridPos": { "h": 10, "w": 8, "x": 0, "y": 45 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "legendFormat": "{{level}}", "expr": "sum by (level) (rate(logback_events_total{application=~\"${application:regex}\", instance=~\"${instance:regex}\", level=~\"error|warn|info\"}[$__rate_interval]))" } ],
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "drawStyle": "bars", "fillOpacity": 70, "lineWidth": 1, "stacking": { "mode": "normal" }, "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "error" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] },
          { "matcher": { "id": "byName", "options": "warn" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
