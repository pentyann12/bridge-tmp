{
  "uid": "lgtm-tomcat-jvm",
  "title": "Tomcat / JVM (JMX exporter)",
  "description": "JMX Exporterで収集したTomcatのスレッドプール・リクエスト・WAR別の状況とJVMの状態",
  "tags": ["lgtm", "tomcat", "jvm"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "15s",
  "schemaVersion": 41,
  "time": { "from": "now-30m", "to": "now" },
  "links": [
    { "title": "LGTM", "type": "dashboards", "tags": ["lgtm"], "asDropdown": true, "icon": "external link" }
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Tomcat",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "qryType": 1, "query": "label_values(tomcat_serverinfo_total, instance)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "definition": "label_values(tomcat_serverinfo_total, instance)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "type": "row", "title": "Overview", "id": 1, "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "panels": []
    },
    {
      "type": "stat", "title": "Tomcat", "id": 2,
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "instant": true, "legendFormat": "{{serverinfo}}", "expr": "tomcat_serverinfo_total{instance=\"$instance\"}" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "name", "colorMode": "none", "graphMode": "none", "text": { "valueSize": 18 } }
    },
    {
      "type": "stat", "title": "Java", "id": 3,
      "gridPos": { "h": 3, "w": 5, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "instant": true, "legendFormat": "{{vendor}} {{version}}", "expr": "jvm_runtime_info{instance=\"$instance\"}" } ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "name", "colorMode": "none", "graphMode": "none", "text": { "valueSize": 18 } }
    },
    {
      "type": "stat", "title": "Uptime", "id": 4,
      "gridPos": { "h": 3, "w": 3, "x": 9, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "instant": true, "expr": "time() - process_start_time_seconds{instance=\"$instance\"}" } ],
      "fieldConfig": { "defaults": { "unit": "dtdurations", "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value", "colorMode": "none", "graphMode": "none", "text": { "valueSize": 18 } }
    },
    {
      "type": "stat", "title": "Requests / sec", "id": 5,
      "gridPos": { "h": 3, "w": 3, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum(rate(tomcat_requestcount_total{instance=\"$instance\"}[$__rate_interval]))" } ],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value", "colorMode": "value", "graphMode": "area" }
    },
    {
      "type": "stat", "title": "Error rate", "id": 6,
      "description": "Tomcatがエラーとして数えたリクエストの割合 (4xx/5xxを含む)",
      "gridPos": { "h": 3, "w": 3, "x": 15, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "100 * sum(rate(tomcat_errorcount_total{instance=\"$instance\"}[$__rate_interval])) / sum(rate(tomcat_requestcount_total{instance=\"$instance\"}[$__rate_interval]))" } ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 5 }, { "color": "red", "value": 20 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value", "colorMode": "value", "graphMode": "area" }
    },
    {
      "type": "gauge", "title": "Thread pool usage", "id": 7,
      "gridPos": { "h": 6, "w": 3, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "100 * max(tomcat_threadpool_currentthreadsbusy{instance=\"$instance\"} / tomcat_threadpool_maxthreads{instance=\"$instance\"})" } ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100, "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 70 }, { "color": "red", "value": 90 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdMarkers": true }
    },
    {
      "type": "gauge", "title": "Heap usage", "id": 8,
      "gridPos": { "h": 6, "w": 3, "x": 21, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "100 * jvm_memory_used_bytes{instance=\"$instance\", area=\"heap\"} / jvm_memory_max_bytes{instance=\"$instance\", area=\"heap\"}" } ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100, "decimals": 0,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 75 }, { "color": "red", "value": 90 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdMarkers": true }
    },
    {
      "type": "stat", "title": "Active sessions", "id": 9,
      "gridPos": { "h": 3, "w": 3, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum(tomcat_session_active{instance=\"$instance\"})" } ],
      "fieldConfig": { "defaults": { "unit": "none", "color": { "mode": "fixed", "fixedColor": "purple" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value", "colorMode": "value", "graphMode": "area" }
    },
    {
      "type": "stat", "title": "Connections", "id": 10,
      "gridPos": { "h": 3, "w": 3, "x": 3, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum(tomcat_threadpool_connectioncount{instance=\"$instance\"})" } ],
      "fieldConfig": { "defaults": { "unit": "none", "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value", "colorMode": "value", "graphMode": "area" }
    },
    {
      "type": "stat", "title": "Avg response time", "id": 11,
      "gridPos": { "h": 3, "w": 3, "x": 6, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "sum(rate(tomcat_processingtime_total{instance=\"$instance\"}[$__rate_interval])) / sum(rate(tomcat_requestcount_total{instance=\"$instance\"}[$__rate_interval]))" } ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms", "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 300 }, { "color": "red", "value": 1000 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value", "colorMode": "value", "graphMode": "area" }
    },
    {
      "type": "stat", "title": "GC time", "id": 12,
      "description": "直近の時間のうちGCに費やした割合",
      "gridPos": { "h": 3, "w": 3, "x": 9, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "100 * sum(rate(jvm_gc_collection_seconds_sum{instance=\"$instance\"}[$__rate_interval]))" } ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 5 }, { "color": "red", "value": 10 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value", "colorMode": "value", "graphMode": "area" }
    },
    {
      "type": "stat", "title": "Live threads", "id": 13,
      "gridPos": { "h": 3, "w": 3, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "jvm_threads_current{instance=\"$instance\"}" } ],
      "fieldConfig": { "defaults": { "unit": "none", "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value", "colorMode": "value", "graphMode": "area" }
    },
    {
      "type": "stat", "title": "Deadlocked threads", "id": 14,
      "gridPos": { "h": 3, "w": 3, "x": 15, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "expr": "jvm_threads_deadlocked{instance=\"$instance\"}" } ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "textMode": "value", "colorMode": "background", "graphMode": "none" }
    },
    {
      "type": "row", "title": "Tomcat", "id": 20, "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 }, "panels": []
    },
    {
      "type": "timeseries", "title": "Thread pool", "id": 21,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "busy ({{protocol}}-{{port}})", "expr": "tomcat_threadpool_currentthreadsbusy{instance=\"$instance\"}" },
        { "refId": "B", "legendFormat": "current ({{protocol}}-{{port}})", "expr": "tomcat_threadpool_currentthreadcount{instance=\"$instance\"}" },
        { "refId": "C", "legendFormat": "max ({{protocol}}-{{port}})", "expr": "tomcat_threadpool_maxthreads{instance=\"$instance\"}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "^max.*" }, "properties": [
            { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
            { "id": "custom.fillOpacity", "value": 0 },
            { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [6, 4] } }
          ] },
          { "matcher": { "id": "byRegexp", "options": "^busy.*" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Requests / errors per second", "id": 22,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "requests ({{protocol}}-{{port}})", "expr": "rate(tomcat_requestcount_total{instance=\"$instance\"}[$__rate_interval])" },
        { "refId": "B", "legendFormat": "errors ({{protocol}}-{{port}})", "expr": "rate(tomcat_errorcount_total{instance=\"$instance\"}[$__rate_interval])" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "^errors.*" }, "properties": [ { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } } ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Response time", "id": 23,
      "description": "avg: 処理時間の合計 ÷ リクエスト数、max: 起動後の最大処理時間",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "avg ({{protocol}}-{{port}})", "expr": "rate(tomcat_processingtime_total{instance=\"$instance\"}[$__rate_interval]) / rate(tomcat_requestcount_total{instance=\"$instance\"}[$__rate_interval])" },
        { "refId": "B", "legendFormat": "max ({{protocol}}-{{port}})", "expr": "tomcat_maxtime_total{instance=\"$instance\"}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ms", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "^max.*" }, "properties": [
            { "id": "custom.fillOpacity", "value": 0 },
            { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [6, 4] } },
            { "id": "custom.axisPlacement", "value": "right" }
          ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Connections", "id": 24,
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "connections ({{protocol}}-{{port}})", "expr": "tomcat_threadpool_connectioncount{instance=\"$instance\"}" },
        { "refId": "B", "legendFormat": "keep-alive ({{protocol}}-{{port}})", "expr": "tomcat_threadpool_keepalivecount{instance=\"$instance\"}" }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Network traffic (received + / sent −)", "id": 25,
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "received ({{protocol}}-{{port}})", "expr": "rate(tomcat_bytesreceived_total{instance=\"$instance\"}[$__rate_interval])" },
        { "refId": "B", "legendFormat": "sent ({{protocol}}-{{port}})", "expr": "-rate(tomcat_bytessent_total{instance=\"$instance\"}[$__rate_interval])" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 20, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "row", "title": "Applications (WAR)", "id": 30, "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }, "panels": []
    },
    {
      "type": "table", "title": "Applications", "id": 31,
      "description": "サーブレットの値をWAR (コンテキスト) ごとに集計 (直近5分)",
      "gridPos": { "h": 9, "w": 14, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "format": "table", "instant": true, "range": false, "expr": "sum by (module) (rate(tomcat_servlet_requestcount_total{instance=\"$instance\"}[5m]))" },
        { "refId": "B", "format": "table", "instant": true, "range": false, "expr": "sum by (module) (rate(tomcat_servlet_errorcount_total{instance=\"$instance\"}[5m]))" },
        { "refId": "C", "format": "table", "instant": true, "range": false, "expr": "sum by (module) (rate(tomcat_servlet_processingtime_total{instance=\"$instance\"}[5m])) / sum by (module) (rate(tomcat_servlet_requestcount_total{instance=\"$instance\"}[5m]))" },
        { "refId": "D", "format": "table", "instant": true, "range": false, "expr": "label_join(sum by (host, context) (tomcat_session_active{instance=\"$instance\"}), \"module\", \"\", \"host\", \"context\")" }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": {
            "excludeByName": { "Time": true, "context": true, "host": true },
            "indexByName": { "module": 0, "Value #A": 1, "Value #B": 2, "Value #C": 3, "Value #D": 4 },
            "renameByName": { "module": "Application", "Value #A": "Requests/s", "Value #B": "Errors/s", "Value #C": "Avg time", "Value #D": "Sessions" }
        } },
        { "id": "sortBy", "options": { "sort": [ { "field": "Requests/s", "desc": true } ] } }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" } } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Requests/s" }, "properties": [
            { "id": "unit", "value": "reqps" }, { "id": "decimals", "value": 2 },
            { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "lcd" } },
            { "id": "color", "value": { "mode": "continuous-BlPu" } }
          ] },
          { "matcher": { "id": "byName", "options": "Errors/s" }, "properties": [
            { "id": "unit", "value": "reqps" }, { "id": "decimals", "value": 2 },
            { "id": "custom.cellOptions", "value": { "type": "color-text" } },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.01 } ] } }
          ] },
          { "matcher": { "id": "byName", "options": "Avg time" }, "properties": [
            { "id": "unit", "value": "ms" }, { "id": "decimals", "value": 1 },
            { "id": "custom.cellOptions", "value": { "type": "color-text" } },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 300 }, { "color": "red", "value": 1000 } ] } }
          ] },
          { "matcher": { "id": "byName", "options": "Sessions" }, "properties": [ { "id": "unit", "value": "none" } ] }
        ]
      },
      "options": { "showHeader": true, "cellHeight": "sm", "footer": { "show": false } }
    },
    {
      "type": "timeseries", "title": "Active sessions by application", "id": 32,
      "gridPos": { "h": 9, "w": 10, "x": 14, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "legendFormat": "{{context}}", "expr": "sum by (context) (tomcat_session_active{instance=\"$instance\"})" } ],
      "fieldConfig": { "defaults": { "unit": "none", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 40, "stacking": { "mode": "normal" }, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "row", "title": "JVM", "id": 40, "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 33 }, "panels": []
    },
    {
      "type": "timeseries", "title": "Heap", "id": 41,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "used", "expr": "jvm_memory_used_bytes{instance=\"$instance\", area=\"heap\"}" },
        { "refId": "B", "legendFormat": "committed", "expr": "jvm_memory_committed_bytes{instance=\"$instance\", area=\"heap\"}" },
        { "refId": "C", "legendFormat": "max", "expr": "jvm_memory_max_bytes{instance=\"$instance\", area=\"heap\"}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "used" }, "properties": [ { "id": "custom.fillOpacity", "value": 30 }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] },
          { "matcher": { "id": "byName", "options": "max" }, "properties": [
            { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
            { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [6, 4] } }
          ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Heap pools", "id": 42,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "legendFormat": "{{pool}}", "expr": "jvm_memory_pool_used_bytes{instance=\"$instance\", pool=~\".*(Eden|Survivor|Old|Tenured).*\"}" } ],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 40, "stacking": { "mode": "normal" }, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries", "title": "Non-heap", "id": 43,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 34 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "{{pool}}", "expr": "jvm_memory_pool_used_bytes{instance=\"$instance\", pool!~\".*(Eden|Survivor|Old|Tenured).*\"}" },
        { "refId": "B", "legendFormat": "direct buffers", "expr": "jvm_buffer_pool_used_bytes{instance=\"$instance\", pool=\"direct\"}" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 40, "stacking": { "mode": "normal" }, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries", "title": "GC", "id": 44,
      "description": "棒: GC回数/秒、線: GCに費やした時間の割合",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "{{gc}} count/s", "expr": "rate(jvm_gc_collection_seconds_count{instance=\"$instance\"}[$__rate_interval])" },
        { "refId": "B", "legendFormat": "{{gc}} time %", "expr": "100 * rate(jvm_gc_collection_seconds_sum{instance=\"$instance\"}[$__rate_interval])" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1, "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": ".*time %$" }, "properties": [
            { "id": "unit", "value": "percent" },
            { "id": "custom.drawStyle", "value": "line" },
            { "id": "custom.lineWidth", "value": 2 },
            { "id": "custom.fillOpacity", "value": 0 },
            { "id": "custom.axisPlacement", "value": "right" }
          ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "type": "timeseries", "title": "Threads", "id": 45,
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "legendFormat": "{{state}}", "expr": "jvm_threads_state{instance=\"$instance\"} > 0" } ],
      "fieldConfig": { "defaults": { "unit": "none", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 50, "stacking": { "mode": "normal" }, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "type": "timeseries", "title": "CPU / classes", "id": 46,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 42 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "legendFormat": "CPU (cores)", "expr": "rate(process_cpu_seconds_total{instance=\"$instance\"}[$__rate_interval])" },
        { "refId": "B", "legendFormat": "loaded classes", "expr": "jvm_classes_currently_loaded{instance=\"$instance\"}" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "min": 0, "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "loaded classes" }, "properties": [
            { "id": "custom.axisPlacement", "value": "right" },
            { "id": "custom.fillOpacity", "value": 0 },
            { "id": "custom.lineWidth", "value": 1 }
          ] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    }
  ]
}
